FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=aml_data_model
HF_TOKEN=

# Generation backend: "ollama" (default, Defog SQLCoder via a local Ollama
# server -- no fine-tuning needed) or "t5" (the original gaussalgo checkpoint,
# optionally fine-tuned under training/finetuned_model/).
MODEL_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mannix/defog-llama3-sqlcoder-8b
