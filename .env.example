FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=aml_data_model
HF_TOKEN=

# Defog SQLCoder via a local Ollama server -- no fine-tuning needed.
MODEL_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mannix/defog-llama3-sqlcoder-8b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=240
# auto uses FalkorDB when configured; catalog reads deployed schema metadata.
SCHEMA_BACKEND=auto
