  "metrics": [
    {
      "id": "transaction_trend",
      "question": "Show monthly transaction volume and value by direction",
      "aliases": [
        "monthly transaction volume",
        "transaction volume and value trend"
      ],
      "sql": "\nSELECT DATE_TRUNC(DATE(book_time), MONTH) AS month, direction,\n       COUNT(*) AS transaction_count,\n       SUM(CAST(normalized_booked_amount.units AS NUMERIC)\n           + CAST(normalized_booked_amount.nanos AS NUMERIC) / 1000000000) AS amount_usd\nFROM Transaction\nWHERE COALESCE(is_entity_deleted, FALSE) = FALSE\nGROUP BY month, direction\nORDER BY month, direction\n",
      "units": {
        "transaction_count": "transactions",
        "amount_usd": "USD"
      },
      "chart": "line",
      "dimension": "month",
      "series": "direction"
    },
    {
      "id": "sar_volume",
      "question": "How many cases had SAR filings each month?",
      "aliases": [
        "monthly sar volume",
        "sar filing volume by month"
      ],
      "sql": "\nSELECT DATE_TRUNC(DATE(event_time), MONTH) AS month,\n       COUNT(DISTINCT risk_case_id) AS sar_cases\nFROM RiskCaseEvent WHERE type = 'AML_SAR'\nGROUP BY month ORDER BY month\n",
      "units": {
        "sar_cases": "cases"
      },
      "chart": "bar",
      "dimension": "month",
      "series": null
    },
    {
      "id": "case_backlog",
      "question": "Show open and closed investigation cases",
      "aliases": [
        "case backlog",
        "open versus closed cases"
      ],
      "sql": "\nWITH status AS (\n SELECT risk_case_id,\n MAX(IF(type = 'AML_PROCESS_START', event_time, NULL)) AS started_at,\n MAX(IF(type = 'AML_PROCESS_END', event_time, NULL)) AS ended_at\n FROM RiskCaseEvent GROUP BY risk_case_id\n)\nSELECT COUNTIF(started_at IS NOT NULL AND (ended_at IS NULL OR started_at > ended_at)) AS open_cases,\n       COUNTIF(started_at IS NOT NULL AND ended_at >= started_at) AS closed_cases\nFROM status\n",
      "units": {
        "open_cases": "cases",
        "closed_cases": "cases"
      },
      "chart": "kpi",
      "dimension": null,
      "series": null
    },
    {
      "id": "risk_trend",
      "question": "Show the average risk score by reporting period",
      "aliases": [
        "average risk score trend",
        "risk score trend"
      ],
      "sql": "\nSELECT risk_period_end_time AS period, AVG(risk_score) AS average_risk_score,\n       COUNT(DISTINCT IF(risk_score IS NOT NULL, party_id, NULL)) AS scored_customers\nFROM RiskScores GROUP BY period ORDER BY period\n",
      "units": {
        "average_risk_score": "score (0-1)",
        "scored_customers": "customers"
      },
      "chart": "line",
      "dimension": "period",
      "series": null
    },
    {
      "id": "customer_count",
      "question": "How many active customers were there at the end of August 2026?",
      "aliases": [
        "active customers at dataset end",
        "latest active customer count"
      ],
      "sql": "\nWITH latest AS (\n SELECT party_id, is_entity_deleted, exit_date, join_date,\n ROW_NUMBER() OVER (PARTITION BY party_id ORDER BY validity_start_time DESC) AS row_num\n FROM Party WHERE validity_start_time < TIMESTAMP('2026-09-01 00:00:00+00')\n)\nSELECT COUNT(*) AS active_customers FROM latest\nWHERE row_num = 1 AND COALESCE(is_entity_deleted, FALSE) = FALSE\nAND join_date < DATE('2026-09-01')\nAND (exit_date IS NULL OR exit_date >= DATE('2026-09-01'))\n",
      "units": {
        "active_customers": "customers"
      },
      "chart": "kpi",
      "dimension": null,
      "series": null
    },
    {
      "id": "alert_conversion",
      "question": "What proportion of alerted cases had a SAR?",
      "aliases": [
        "alert to sar conversion rate",
        "alert to sar rate"
      ],
      "sql": "\nWITH alerts AS (\n SELECT DISTINCT risk_case_id FROM RiskCaseEvent\n WHERE type IN ('AML_ALERT_GOOGLE', 'AML_ALERT_LEGACY', 'AML_ALERT_ADHOC',\n                'AML_ALERT_EXPLORATORY', 'AML_ALERT_EXTERNAL')\n), sars AS (\n SELECT DISTINCT risk_case_id FROM RiskCaseEvent WHERE type = 'AML_SAR'\n)\nSELECT COUNT(DISTINCT a.risk_case_id) AS alerted_cases,\nCOUNT(DISTINCT s.risk_case_id) AS sar_cases,\nSAFE_DIVIDE(COUNT(DISTINCT s.risk_case_id), COUNT(DISTINCT a.risk_case_id)) AS conversion_rate\nFROM alerts a LEFT JOIN sars s ON a.risk_case_id = s.risk_case_id\n",
      "units": {
        "alerted_cases": "cases",
        "sar_cases": "cases",
        "conversion_rate": "ratio"
      },
      "chart": "kpi",
      "dimension": null,
      "series": null
    }
  ]
